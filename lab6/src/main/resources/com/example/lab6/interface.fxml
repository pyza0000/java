<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox fx:id="writeRead" alignment="CENTER" nodeOrientation="LEFT_TO_RIGHT" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.lab6.writeReadController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label fx:id="welcomeText" />
   <TextArea fx:id="textField" prefHeight="150.0" prefWidth="200.0" />
   <Button fx:id="buttonWrite" mnemonicParsing="false" onAction="#writeToFile" text="Zapis do pliku">
      <font>
         <Font size="10.0" />
      </font>
   </Button>
    <Button fx:id="buttonRead" onAction="#readFromFile" text="Odczyt z pliku">
      <font>
         <Font size="10.0" />
      </font>
   </Button>
</VBox>
